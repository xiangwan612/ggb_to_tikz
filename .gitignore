# ---------- 机密：本地密钥，禁止提交 ----------
# 后端本地配置。里面可能有：
#   PLATFORM_DEEPSEEK_API_KEY  平台 DeepSeek 密钥
#   JWT_SECRET / API_KEY_ENCRYPTION_SECRET
# 模板见 server/.env.example（那个可以提交，里面只有占位符）。
server/.env

# 通用 dotenv 兜底，防止以后新增别的 .env 文件时漏掉
.env
.env.local
.env.*.local

# 证书与私钥
*.pem
*.key

# ---------- 系统与编辑器 ----------
.DS_Store
**/.DS_Store

# ---------- 依赖 ----------
node_modules/

# ---------- 构建产物与缓存 ----------
# 前端构建产物。GitHub Pages workflow 会在 CI 里自己 npm run build 重新生成，
# 不需要入库（见 .github/workflows/deploy-pages.yml）。
dist/
# Vite 依赖预打包缓存
.vite/

# ---------- 本地调试产物 ----------
output/
.playwright-cli/
