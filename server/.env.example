PORT=8787
HOST=0.0.0.0
DATABASE_URL="file:./dev.db"
JWT_SECRET="please-change-this-in-production"
JWT_EXPIRES_IN=7d
API_KEY_ENCRYPTION_SECRET="please-change-this-too"
EMAIL_CODE_TTL_SEC=300
EMAIL_CODE_MIN_INTERVAL_SEC=60
EMAIL_CODE_DEV_MODE=true
EMAIL_CODE_ALLOW_PLAINTEXT_RESPONSE=false
EMAIL_CODE_HASH_SECRET=
APP_NAME=ggb_ai
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# CORS
# 本地开发可设为 http://localhost:5173
# 多个来源用英文逗号分隔；设为 * 表示全部允许
CORS_ORIGIN=*

# 上游请求超时（毫秒）
UPSTREAM_TIMEOUT_MS=45000

# 平台额度（每天每个 client id 可用次数）
PLATFORM_DAILY_LIMIT=30

# 平台提供的 API Key（按需填写；留空则只支持用户自带 Key）
# 填写后，未自带 Key 的请求会走这个平台 Key，并按 PLATFORM_DAILY_LIMIT 限流
PLATFORM_DEEPSEEK_API_KEY=
